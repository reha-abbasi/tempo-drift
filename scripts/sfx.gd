extends Node

## Sound effects + music (autoload "Sfx"). Sounds are generated by
## tools/make_audio.py - replace the .wav files with real ones any time.

const SOUNDS := {
	"coin": preload("res://assets/audio/coin.wav"),
	"jump": preload("res://assets/audio/jump.wav"),
	"land": preload("res://assets/audio/land.wav"),
	"slide": preload("res://assets/audio/slide.wav"),
	"swipe": preload("res://assets/audio/swipe.wav"),
	"bump": preload("res://assets/audio/bump.wav"),
	"crash": preload("res://assets/audio/crash.wav"),
	"power": preload("res://assets/audio/power.wav"),
	"click": preload("res://assets/audio/click.wav"),
}

var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _music: AudioStreamPlayer


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in 10:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_players.append(p)
	_music = AudioStreamPlayer.new()
	_music.stream = preload("res://assets/audio/music.wav")
	_music.volume_db = -9.0
	_music.finished.connect(_music.play)
	add_child(_music)
	_apply_mute()


func play(sound: String, pitch := 1.0, volume_db := 0.0) -> void:
	var p := _players[_next]
	_next = (_next + 1) % _players.size()
	p.stream = SOUNDS[sound]
	p.pitch_scale = pitch
	p.volume_db = volume_db
	p.play()


func music(on: bool) -> void:
	if on and not _music.playing:
		_music.play()
	elif not on:
		_music.stop()


func toggle_sound() -> bool:
	SaveData.sound_on = not SaveData.sound_on
	SaveData.save()
	_apply_mute()
	return SaveData.sound_on


func _apply_mute() -> void:
	AudioServer.set_bus_mute(0, not SaveData.sound_on)
